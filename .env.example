# Repository-wide environment variables (defaults)
# Place project-wide defaults here. Per-directory `.env` files (e.g.,
# `data_preprocessing/.env`) may override these values for local runs.

# OpenAI / LLM credentials and endpoint
# Set your API key for the OpenAI-compatible client. Leave empty for local dev adapters.
OPENAI_API_KEY = ""
# Base URL for the OpenAI-compatible server (e.g. a local web service, Bedrock proxy, or OpenAI API)
OPENAI_BASE_URL = "http://localhost:8001/v1"

# Default model to use for generation and completion calls
# Examples: gpt-4o-mini, gpt-4o, meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_MODEL = "gpt-4o-mini"

# Multiprocessing / batching defaults for preprocessing scripts
# Number of worker processes to use (int)
NUM_WORKERS = 64
# Save/checkpoint frequency for long preprocessing runs (int)
SAVE_EVERY = 256

# Embedding model selection
# EMBEDDING_MODEL = "contriever"
EMBEDDING_MODEL = "text-embedding-3-small"
EMBEDDING_RETRIEVER="flat-openai"
CACHE_DIR="data/cache"
LLM_TEMPERATURE="0.0"
QA_LLM="gpt-4o-mini"

# Optional: External/third-party embedding API
EMBEDDING_API_URL=""
# API key to authorize requests to EMBEDDING_API_URL (Bearer)
EMBEDDING_API_KEY=""

# Keyphrase extraction defaults
KEYPHRASE_MAX_TOKENS = 100
KEYPHRASE_TEMPERATURE = 0.0

# Summarization defaults
SUMMARY_MAX_TOKENS = 500
SUMMARY_TEMPERATURE = 0.0

# User-fact extraction defaults
USERFACT_MAX_TOKENS = 2000
USERFACT_TEMPERATURE = 1.0