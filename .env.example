# Repository-wide environment variables (defaults)
# Use a single root `.env` file for local configuration.

# Global fallback for all OpenAI-compatible LLM stages.
# Stage-specific values below take priority when they are set to a non-empty value.
OPENAI_API_KEY = ""
OPENAI_BASE_URL = "http://localhost:8001/v1"
LLM_MODEL = "gpt-4o-mini"

# Stage-specific LLM overrides.
# Retrieval usually shares the index-stage graph artifacts and the global embedding config,
# so the stage-specific split is only exposed for index / qa / qa_eval.
# INDEX_API_KEY = ""
# INDEX_BASE_URL = ""
# INDEX_LLM_MODEL = ""

# QA_API_KEY = ""
# QA_BASE_URL = ""
# QA_LLM_MODEL = ""

# QA_EVAL_API_KEY = ""
# QA_EVAL_BASE_URL = ""
# QA_EVAL_LLM_MODEL = ""

# Multiprocessing / batching defaults for preprocessing scripts
# Number of worker processes to use (int)
NUM_WORKERS = 64
# Save/checkpoint frequency for long preprocessing runs (int)
SAVE_EVERY = 256

# Embedding config shared by index / retrieve / qa / qa_eval unless a script overrides it.
EMBEDDING_MODEL = "text-embedding-3-small"
EMBEDDING_RETRIEVER = "flat-openai"
CACHE_DIR = "data/cache"
LLM_TEMPERATURE = "0.0"

# Optional: External/third-party embedding API
EMBEDDING_API_URL = ""
EMBEDDING_API_KEY = ""

# Keyphrase extraction defaults
KEYPHRASE_MAX_TOKENS = 100
KEYPHRASE_TEMPERATURE = 0.0

# Summarization defaults
SUMMARY_MAX_TOKENS = 500
SUMMARY_TEMPERATURE = 0.0

# User-fact extraction defaults
USERFACT_MAX_TOKENS = 2000
USERFACT_TEMPERATURE = 1.0
